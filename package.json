{
  "name": "instrumentacion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestion de instrumental quirurgico - trazabilidad de cajas, ciclos de esterilizacion y descartables por lote",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply instrumentacion --local",
    "db:migrate:remote": "wrangler d1 migrations apply instrumentacion --remote",
    "db:seed:local": "wrangler d1 execute instrumentacion --local --file=./seed/seed.sql",
    "db:reset:local": "node scripts/reset-local.mjs && npm run db:migrate:local && npm run db:seed:local",
    "test": "npm run build:web && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.1",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "jsqr": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.1"
  }
}
